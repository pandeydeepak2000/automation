# Block search engines from indexing any file on this domain
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Protect sensitive files
<FilesMatch "(\.env|\.git|\.sql|\.md|\.log|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow normal access to index.php and api.php
DirectoryIndex index.php
